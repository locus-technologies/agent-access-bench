# Copy to .env and fill in what you need. Only the keys for the arms and models you run are required.

# Models (Inspect AI provider keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Arms B, C, D: web search (Tavily) for every tool-using arm
TAVILY_API_KEY=

# Arm C: Locus Pro (one tenant key reaches the whole catalog over MCP)
LOCUS_PRO_API_KEY=
LOCUS_PRO_MCP_URL=https://api.paywithlocus.com/api/credits/mcp
# Spend battery only: creates one capped end-user sub-account per run
LOCUS_PRO_ADMIN_KEY=

# Arm D: vendors wired directly
APOLLO_API_KEY=
HUNTER_API_KEY=
PROSPEO_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
E2B_API_KEY=

# Graders only (never given to agents)
ZEROBOUNCE_API_KEY=
DATAFORSEO_CREDENTIALS=
X_API_BEARER_TOKEN=
GITHUB_TOKEN=
SEC_USER_AGENT="your-name your-email@example.com"

# Optional: fill missing keys from one AWS Secrets Manager JSON secret
# BENCH_AWS_SECRET_ID=
# BENCH_AWS_REGION=us-east-1
